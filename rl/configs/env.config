[env]
time_limit = 50
time_step = 0.25
val_size = 100
test_size = 500
randomize_attributes = False
randomize_robot_goal = True

[sim]
train_val_sim = hallway_bottleneck
test_sim = hallway_bottleneck
starts_moving = 5
    # how many steps agents can move before robot starts moving
square_width = 20
circle_radius = 10
rect_width = 20
rect_height = 20
human_num = 20

[humans]
visible = true
policy = sfm
    # can be 'orca_plus' for orca simulation or 'sfm' for sfm simulation
radius = 0.4
sensor = coordinates
safety_space = 0.1
    # setting for orca_plus policy
v_pref = 1.0
    # setting for orca_plus policy
A = 3.0
    # setting for sfm policy
B = 0.18
    # setting for sfm policy
KI = 1.0
    # setting for sfm policy
A_static = 2.0
    # setting for sfm policy
B_static = 0.025
    # setting for sfm policy
A_bottleneck = 6.0
    # setting for sfm policy
B_bottleneck = 0.12
    # setting for sfm policy

[robot]
visible = true
policy = ponav
    # policy for robot,
    # set to 'campc' for CollisionAvoidanceMPC, i.e. SICNav-p, SICNav-np, or MPC-CVMM
        # (in policy.config set hum_model and priviledged_info to set the variant of CAMPC)
    # set to 'dwa' for DWA, 'orca_plus' for ORCA.
radius = 0.35
v_pref = 1.0
sensor = coordinates
debug = true


[reward]
success_reward = 1
collision_penalty = -0.25
freezing_penalty = -0.125
discomfort_dist = 0.1
discomfort_penalty_factor = 0.5